# Copy this file to .env.local and fill it in.

# PostgreSQL connection string. Leave empty to run in demo mode
# (sample data kept in memory, nothing is saved).
# Hosted databases usually need ?sslmode=require at the end.
DATABASE_URL=

# Long random string used to sign login cookies. Required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Cloudflare Turnstile: stops bots and scripts from stuffing Customer Choice votes.
# Create a free widget at https://dash.cloudflare.com > Turnstile, add your domain
# (and localhost for testing), then paste both keys here. Leave both empty to switch
# the check off (fine for local testing, NOT for the event).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
