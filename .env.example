# Copy this file to .env.local and fill it in.

# PostgreSQL connection string. Leave empty to run in demo mode
# (sample data kept in memory, nothing is saved, and the sign-in page offers
# four demo accounts instead of UTHM SSO).
# Hosted databases usually need ?sslmode=require at the end.
DATABASE_URL=

# Long random string used to sign login cookies. Required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# UTHM SSO (Google sign-in limited to @student.uthm.edu.my and @uthm.edu.my).
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > Web application.
# Authorised redirect URI:  https://leed.seladevs.my/api/auth/sso/callback
# (add http://localhost:3000/api/auth/sso/callback for local testing).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public address of the site, no trailing slash (e.g. https://leed26.vercel.app).
# Used to build the SSO redirect URI. Leave empty to work it out from the request.
APP_URL=https://leed.seladevs.my

# Committee emails that become admins the first time they sign in, comma separated.
# e.g. ADMIN_EMAILS=nama@uthm.edu.my,ai230001@student.uthm.edu.my
ADMIN_EMAILS=

# Email through Resend (https://resend.com). Leave empty to send no emails: people still get
# notifications under the bell. In Resend: verify your sending domain, then create an API key.
# Stall emails go to the team leader with teammates in CC.
RESEND_API_KEY=
# The sender, on your verified domain, e.g. LEED 26 <leed26@yourdomain.my>
EMAIL_FROM=
# Optional: where replies go, e.g. the committee's inbox
EMAIL_REPLY_TO=

# Google Drive for payment receipts (no extra settings here: it uses GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET above). In Google Cloud Console, for the same OAuth client:
#   1. APIs & Services > Library > Google Drive API > Enable.
#   2. Credentials > your OAuth client > Authorised redirect URIs > add
#      https://leed.seladevs.my/api/admin/drive/callback
#   3. OAuth consent screen > Data access > add the scope .../auth/drive.file
# Then in the app: Admin > Payments > Connect Google Drive, and sign in with the account
# whose Drive should hold the receipts. Share the "LEED 26 payments" folder with the committee.
